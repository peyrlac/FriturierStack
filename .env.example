# ============================================================================
# API
# ============================================================================

# URI de connexion MongoDB de l'API.
MONGO_TOKEN_API=mongodb+srv://user:password@cluster.mongodb.net/friturier-api?retryWrites=true&w=majority

# Token du bot Discord utilisé par l'API.
DISCORD_TOKEN_API=token_du_bot_api

# Secret utilisé pour signer les JWT.
JWT_SECRET=un_long_secret_random

# Mot de passe du dashboard.
DASHBOARD_PASSWORD=mot_de_passe_dashboard

# Channel AFK Discord.
AFK_CHANNEL_ID=

# Chemin de base de l'API.
BASE_PATH=

# ============================================================================
# BOT - MANDATORY
# ============================================================================

# Token du bot Discord.
DISCORD_TOKEN=

# URI de connexion MongoDB.
MONGO_TOKEN=mongodb+srv://user:password@cluster.mongodb.net/friturier?retryWrites=true&w=majority

# Identifiant de l'application Discord.
DISCORD_ID=

# Channel de travail pour les uploads iCal et la feature spoiler.
UPLOAD_CHANNEL_ID=

# ============================================================================
# BOT - OPTIONAL - DISCORD AND WEBHOOKS
# ============================================================================

# Identifiant du webhook Discord utilisé par le bot.
WEBHOOK_ID=

# Token du webhook Discord utilisé par le bot.
WEBHOOK_TOKEN=

# Statut personnalisé affiché par le bot.
DISCORD_STATUS=""

# Supprime les commandes de guilde lors du nettoyage de Discord.
DISCORD_CLEANUP_GUILD_COMMANDS=false

# ============================================================================
# BOT - OPTIONAL - DATABASE AND RUNTIME
# ============================================================================

# Serveurs DNS optionnels, séparés par des virgules, pour résoudre mongodb+srv.
MONGO_DNS_SERVERS=

# Environnement d'exécution.
NODE_ENV=production

# Identifiant Discord du propriétaire du bot.
BOT_OWNER_ID=

# ============================================================================
# SHARED - OPTIONAL - STATISTICS AND EXTERNAL APIS
# ============================================================================

# URL interne de l'API de statistiques utilisée par le bot.
STATS_API_URL=http://friturier-api:3001

# URL historique utilisée par certaines versions du bot.
STATS_API_BASE=http://friturier-api:3001

# Clé d'authentification de l'API de statistiques.
STATS_API_KEY=

# Token API Top.gg pour les statistiques de vote.
TOPGG_TOKEN=

# Clé API OpenAI.
OPENAI=

# ============================================================================
# BOT - OPTIONAL - MUSIC
# ============================================================================

# Station ou source radio utilisée par les fonctionnalités musicales.
RADIO=

# Identifiant client de l'application Spotify.
SPOTIFY_CLIENT_ID=

# Secret client de l'application Spotify.
SPOTIFY_CLIENT_SECRET=

# Token GIPHY utilisé par les fonctionnalités d'images.
GIPHY_TOKEN=

# Adresse de l'instance Lavalink.
LAVALINK_HOST=lavalink

# Mot de passe de l'instance Lavalink.
LAVALINK_PASSWORD=

# Port de l'instance Lavalink.
LAVALINK_PORT=2333

# Indique si la connexion Lavalink doit utiliser TLS.
LAVALINK_SECURE=false

# Active ou désactive Lavalink.
LAVALINK_ENABLED=true

# Options JVM du conteneur Lavalink.
LAVALINK_JAVA_OPTIONS=--Xmx1G

# ============================================================================
# DOCKER
# ============================================================================

# Ports exposes par les services.
API_PORT=3001
BOT_PORT=3000
